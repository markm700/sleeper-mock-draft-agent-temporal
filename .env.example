# Sleeper Env Variables
SLEEPER_USERNAME=sleeper_username_here
SLEEPER_LEAGUE_NAME=sleeper_league_name_of_interest_here

# Database Configuration
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=sleeper_draft_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Temporal Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=example-task-queue

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# ML/Analysis Configuration
DEFAULT_SIMULATION_COUNT=1000
ADP_RECENCY_WEIGHT=0.7
